#!/usr/bin/env bash

set -euo pipefail

if [[ "$(uname -s)" != Darwin ]]; then
	printf '%s\n' 'This prototype supports macOS only.' >&2
	exit 1
fi

ps_snapshot="$(ps -U "$(id -u)" -o pid=,tty=,command=)"
agent_pid=()
agent_tty=()
agent_name=()

while IFS=' ' read -r pid tty command_line; do
	[[ -n "${pid:-}" && -n "${command_line:-}" ]] || continue
	executable="${command_line%%[[:space:]]*}"
	name="${executable##*/}"
	label=""
	case "$name" in
		codex) label=codex ;;
		claude) label=claude ;;
		opencode) label=opencode ;;
		node|bun)
			if [[ "$command_line" =~ ^[^[:space:]]+[[:space:]]+[^[:space:]]*/@openai/codex/bin/codex\.js([[:space:]]|$) ]]; then
				label=codex
			elif [[ "$command_line" =~ ^[^[:space:]]+[[:space:]]+[^[:space:]]*/@anthropic-ai/claude-code/cli\.js([[:space:]]|$) ]]; then
				label=claude
			fi
			;;
	esac
	[[ -n "$label" ]] || continue
	agent_pid+=("$pid")
	agent_tty+=("${tty#/dev/}")
	agent_name+=("$label")
done <<<"$ps_snapshot"

terminal_ttys=()
terminal_titles=()
if terminal_result="$(osascript -e '
if application "Terminal" is not running then return ""
tell application "Terminal"
	set terminalTTYs to tty of selected tab of every window
	set terminalNames to name of every window
end tell
if (count of terminalTTYs) is not (count of terminalNames) then return ""
set outputText to ""
repeat with itemIndex from 1 to count of terminalTTYs
	set terminalTTY to item itemIndex of terminalTTYs
	if terminalTTY is not missing value then
		set terminalName to item itemIndex of terminalNames
		if terminalName is missing value then set terminalName to ""
		set outputText to outputText & terminalTTY & tab & terminalName & linefeed
	end if
end repeat
return outputText
' 2>/dev/null)"; then
	while IFS=$'\t' read -r tty_entry title_entry; do
		[[ -n "$tty_entry" ]] || continue
		terminal_ttys+=("${tty_entry#/dev/}")
		terminal_titles+=("$title_entry")
	done <<<"$terminal_result"
fi

if ((${#agent_pid[@]} == 0)); then
	printf '%s\n' 'No recognized agent processes found.'
fi

for ((i = 0; i < ${#agent_pid[@]}; i++)); do
	printf '%s\n' "${agent_name[i]}"
	printf '  pid: %s\n' "${agent_pid[i]}"
	printf '  tty: %s\n' "${agent_tty[i]}"
	terminal_label='not identified'
	if [[ -n "${agent_tty[i]}" && "${agent_tty[i]}" != '??' && "${agent_tty[i]}" != - ]]; then
		for ((j = 0; j < ${#terminal_ttys[@]}; j++)); do
			if [[ "${agent_tty[i]}" == "${terminal_ttys[j]}" ]]; then
				terminal_label="${terminal_titles[j]:-matched Terminal.app}"
				break
			fi
		done
	fi
	printf '  terminal: %s\n' "$terminal_label"
	printf '\n'
done
