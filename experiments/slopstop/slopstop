#!/usr/bin/env bash

# slopstop 0.1.0
# Concise, conservative reports of forgotten local developer workloads.

set -uo pipefail

readonly SLOPSTOP_VERSION="0.1.0"
readonly MIN_OLD_AGE_SECONDS=$((8 * 60 * 60))
readonly HIGH_CPU_AGE_SECONDS=$((60 * 60))
readonly REVIEW_CPU_PERCENT=5
readonly HIGH_CPU_PERCENT=20
readonly REVIEW_RSS_KB=$((2 * 1024 * 1024))
# Two-column layout: name (12) + gap (2) + details (rest). PID and metrics live in details.
readonly NAME_COLUMN_WIDTH=12
readonly MIN_DETAIL_WIDTH=20
# Review CPU uses instantaneous ps %CPU as a fast heuristic (review-only; never
# used for safe-stop). Prefer speed over a multi-second top sample.

mode="scan"
tmp_dir=""
current_snapshot=""
current_user=""
ps_command=""
sort_command=""
progress_active=0
progress_shown_marked=0
safe_kind=(); safe_name=(); safe_age=(); safe_cpu=(); safe_memory=(); safe_details=(); safe_id=()
review_pid=(); review_name=(); review_age=(); review_cpu=(); review_memory=(); review_details=()

usage() {
	printf '%s\n' \
		"SlopStop $SLOPSTOP_VERSION" \
		"Usage: slopstop [--stop|--stop-safe|--help]" \
		"  (default)   Scan and report only; never changes machine state." \
		"  --stop      Stop all safe candidates after one y/N confirmation." \
		"  --stop-safe Stop all safe candidates without prompting." \
		"  --help      Show this help." \
		"Review candidates are never stopped automatically."
}
fail() { printf 'Error: %s\n' "$1" >&2; exit 1; }
cleanup() {
	clear_scan_progress
	[[ -n "$tmp_dir" && -d "$tmp_dir" ]] && rm -rf -- "$tmp_dir"
}
trap cleanup EXIT
# Static TTY status only (no background spinner: killing a job prints
# "Terminated: 15" and earlier hang bugs). Test hooks:
#   SLOPSTOP_PROGRESS_SHOWN_FILE / SLOPSTOP_PROGRESS_CLEARED_FILE
mark_progress_shown() {
	if ((progress_shown_marked == 0)) && [[ -n "${SLOPSTOP_PROGRESS_SHOWN_FILE:-}" ]]; then
		: >"$SLOPSTOP_PROGRESS_SHOWN_FILE"
		progress_shown_marked=1
	fi
}
show_scan_progress() {
	local label="$1"
	mark_progress_shown
	[[ -t 1 ]] || return 0
	# Replace any previous status line in place; no child process.
	printf '\r\033[2K%s' "$label"
	progress_active=1
}
clear_scan_progress() {
	if ((progress_active)); then
		printf '\r\033[2K'
		progress_active=0
	fi
	if [[ -n "${SLOPSTOP_PROGRESS_CLEARED_FILE:-}" ]]; then
		: >"$SLOPSTOP_PROGRESS_CLEARED_FILE"
	fi
}
interrupt() {
	clear_scan_progress
	trap - INT
	exit 130
}
trap interrupt INT

while (($# > 0)); do
	case "$1" in
		--stop) mode="prompt" ;;
		--stop-safe) mode="safe" ;;
		--help|-h) usage; exit 0 ;;
		*) usage >&2; exit 1 ;;
	esac
	shift
done

[[ "$(uname -s)" == "Darwin" ]] || fail "SlopStop supports macOS only"
current_user="$(id -un 2>/dev/null || true)"
[[ -n "$current_user" ]] || fail "could not determine current user"
ps_command="$(command -v ps 2>/dev/null || true)"
[[ -n "$ps_command" ]] || fail "ps is required"
sort_command="$(command -v sort 2>/dev/null || true)"
[[ -n "$sort_command" ]] || fail "sort is required"

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/slopstop.XXXXXX")" || fail "could not create temporary directory"
first_snapshot="$tmp_dir/first"
second_snapshot="$tmp_dir/second"

take_snapshot() {
	local destination="$1"
	"$ps_command" -axo user= -o pid= -o ppid= -o etime= -o '%cpu=' -o rss= -o command= >"$destination" || fail "could not read the process table"
}
take_snapshot "$first_snapshot"

# Fresh ps for review heuristics (no multi-second sample). Progress covers this
# and classification; clear only when the review report is ready to print.
collect_and_prepare_reviews() {
	show_scan_progress "Preparing report..."
	take_snapshot "$second_snapshot"
	current_snapshot="$second_snapshot"
	collect_reviews "$second_snapshot"
	clear_scan_progress
}

age_seconds() {
	local value="$1" days=0 hours=0 minutes=0 seconds=0
	if [[ "$value" == *-* ]]; then days="${value%%-*}"; value="${value#*-}"; fi
	IFS=: read -r hours minutes seconds <<<"$value"
	if [[ -z "${seconds:-}" ]]; then seconds="$minutes"; minutes="$hours"; hours=0; fi
	printf '%s\n' $((10#$days * 86400 + 10#$hours * 3600 + 10#$minutes * 60 + 10#$seconds))
}
format_age() {
	local seconds="$1"
	if [[ "$seconds" == "—" ]]; then printf '—'; elif ((seconds >= 86400)); then printf '%dd' $((seconds / 86400)); elif ((seconds >= 3600)); then printf '%dh' $((seconds / 3600)); else printf '%dm' $((seconds / 60)); fi
}
format_memory() {
	local kb="$1" tenths
	if [[ "$kb" == "—" ]]; then
		printf '—'
	elif ((kb >= 1048576)); then
		# One decimal place, rounded (matches prior awk %.1f).
		tenths=$(( (kb * 10 + 524288) / 1048576 ))
		printf '%d.%d GB' $((tenths / 10)) $((tenths % 10))
	elif ((kb >= 1024)); then
		# Rounded whole MB (matches prior awk %.0f).
		printf '%d MB' $(( (kb + 512) / 1024 ))
	else
		printf '%d KB' "$kb"
	fi
}
format_cpu() { [[ "$1" == "—" ]] && printf '—' || printf '%s%%' "$1"; }
normalize_process_name() { local first="${1%% *}" base; base="${first##*/}"; printf '%s\n' "$base"; }

# name is the basename of the first argv token; command_line is the full command.
recognized_process() {
	local name="$1" command_line="$2"
	[[ "$command_line" == *opencode* ]] && return 0
	case "$name:$command_line" in
		opencode:*|*:*bun*opencode*) return 0 ;;
		java:*gradle*|java:*GradleDaemon*|java:*kotlin*|java:*KotlinCompileDaemon*|java:*mvnd*|java:*maven.daemon*) return 0 ;;
		mvnd:*|gradle:*|kotlin-daemon:*|vite:*|next:*|webpack:*|nodemon:*|air:*|cargo-watch:*) return 0 ;;
		*:*'python -m http.server'*|*:*'python3 -m http.server'*|*:*'go run '*|*:*'cargo watch'*) return 0 ;;
		*:*--remote-debugging-*|*:*--headless*) return 0 ;;
	esac
	return 1
}
is_review_candidate() {
	local age="$1" cpu_int="${2%.*}" rss="$3"
	((age >= MIN_OLD_AGE_SECONDS && cpu_int >= REVIEW_CPU_PERCENT)) && return 0
	((age >= MIN_OLD_AGE_SECONDS && rss >= REVIEW_RSS_KB)) && return 0
	((age >= HIGH_CPU_AGE_SECONDS && cpu_int >= HIGH_CPU_PERCENT)) && return 0
	return 1
}
# Single-pass ps parse: user filter, age, allowlist, thresholds. CPU is the
# instantaneous ps %CPU heuristic (acceptable for review-only rows).
collect_reviews() {
	local snapshot="$1" user pid ppid elapsed cpu rss command_line age name
	local value days hours minutes seconds first reason cpu_int
	local formatted_age formatted_cpu formatted_memory
	: >"$tmp_dir/reviews"
	while read -r user pid ppid elapsed cpu rss command_line; do
		[[ -n "${pid:-}" && "$pid" != "PID" ]] || continue
		[[ "$user" == "$current_user" ]] || continue
		[[ "$pid" =~ ^[0-9]+$ && "$rss" =~ ^[0-9]+$ ]] || continue
		[[ "$cpu" =~ ^[0-9]+([.][0-9]+)?$ ]] || continue

		value="$elapsed" days=0 hours=0 minutes=0 seconds=0
		if [[ "$value" == *-* ]]; then days="${value%%-*}"; value="${value#*-}"; fi
		IFS=: read -r hours minutes seconds <<<"$value"
		if [[ -z "${seconds:-}" ]]; then seconds="$minutes"; minutes="$hours"; hours=0; fi
		age=$((10#$days * 86400 + 10#$hours * 3600 + 10#$minutes * 60 + 10#$seconds))

		first="${command_line%% *}"
		name="${first##*/}"
		recognized_process "$name" "$command_line" || continue
		is_review_candidate "$age" "$cpu" "$rss" || continue

		cpu_int="${cpu%.*}"
		if ((age >= MIN_OLD_AGE_SECONDS && cpu_int >= REVIEW_CPU_PERCENT)) || ((age >= HIGH_CPU_AGE_SECONDS && cpu_int >= HIGH_CPU_PERCENT)); then
			reason="elevated CPU"
		else
			reason="high memory developer workload"
		fi

		printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$pid" "$name" "$age" "$cpu" "$rss" "$reason" >>"$tmp_dir/reviews"
	done <"$snapshot"
	while IFS=$'\t' read -r pid name age cpu rss detail; do
		formatted_age="$(format_age "$age")"
		formatted_cpu="$(format_cpu "$cpu")"
		formatted_memory="$(format_memory "$rss")"
		review_pid+=("$pid")
		review_name+=("$name")
		review_age+=("$formatted_age")
		review_cpu+=("$formatted_cpu")
		review_memory+=("$formatted_memory")
		review_details+=("$detail")
	done < <(LC_ALL=C "$sort_command" -t $'\t' -k4,4nr "$tmp_dir/reviews")
}
add_safe() {
	safe_kind+=("$1"); safe_name+=("$2"); safe_age+=("$3"); safe_cpu+=("$4"); safe_memory+=("$5"); safe_details+=("$6"); safe_id+=("$7")
}

# Pure check: Colima is running with zero active containers on its own runtime.
# Returns 0 when safe to stop, 1 otherwise. Does not mutate report arrays.
colima_still_safe() {
	local colima status_json status runtime profile context runtime_command containers
	colima="$(command -v colima 2>/dev/null || true)"; [[ -n "$colima" ]] || return 1
	status_json="$("$colima" status --json 2>/dev/null)" || return 1
	status_json="$(tr -d '[:space:]' <<<"$status_json")"
	status="$(sed -n 's/.*"status"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' <<<"$status_json")"
	[[ -z "$status" || "$status" == Running ]] || return 1
	runtime="$(sed -n 's/.*"runtime"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' <<<"$status_json")"
	profile="$(sed -n 's/.*"profile"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' <<<"$status_json")"
	[[ -n "$profile" ]] || profile="default"
	if [[ "$profile" == default ]]; then context="colima"; else context="colima-$profile"; fi
	case "$runtime" in
		docker) runtime_command="$(command -v docker 2>/dev/null || true)" ;;
		containerd) runtime_command="$(command -v nerdctl 2>/dev/null || true)" ;;
		*) return 1 ;;
	esac
	[[ -n "$runtime_command" ]] || return 1
	if [[ "$runtime" == docker ]]; then
		# Never use the globally selected Docker context: it may point at a
		# different daemon while Colima is idle.
		containers="$("$runtime_command" --context "$context" ps -q 2>/dev/null)" || return 1
	else
		containers="$("$runtime_command" --address "unix://${HOME:-}/.colima/${profile}/containerd.sock" ps -q 2>/dev/null)" || return 1
	fi
	[[ -z "$containers" ]] || return 1
	return 0
}
detect_colima() {
	colima_still_safe || return 0
	add_safe "colima" "Colima" "—" "—" "—" "Running; no active containers" "colima"
}
process_row_for_pid() {
	local wanted="$1" snapshot="$2" user pid ppid elapsed cpu rss command_line
	while read -r user pid ppid elapsed cpu rss command_line; do
		if [[ "$pid" == "$wanted" ]]; then printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$user" "$pid" "$ppid" "$elapsed" "$cpu" "$rss" "$command_line"; return 0; fi
	done <"$snapshot"
	return 1
}
# Pure browser safety evaluation against current_snapshot and launch-state.
# Optional required_pid pins revalidation to the reported candidate.
# On success prints: pid\telapsed\tcpu\trss and returns 0. Never mutates report arrays.
evaluate_browser_safe() {
	local required_pid="${1:-}"
	local state_file="${HOME:-}/.browser-testing-profile/launch-state"
	local key value service="" recorded_pid="" row user pid ppid elapsed cpu rss command_line
	[[ -f "$state_file" ]] || return 1
	while IFS='=' read -r key value; do case "$key" in service) service="$value" ;; pid) recorded_pid="$value" ;; esac; done <"$state_file"
	[[ "$service" == xyz.pvrlabs.browser.* ]] || return 1
	case "$recorded_pid" in ''|*[!0-9]*) return 1 ;; esac
	if [[ -n "$required_pid" && "$recorded_pid" != "$required_pid" ]]; then return 1; fi
	row="$(process_row_for_pid "$recorded_pid" "$current_snapshot" 2>/dev/null)" || return 1
	IFS=$'\t' read -r user pid ppid elapsed cpu rss command_line <<<"$row"
	[[ "$user" == "$current_user" ]] || return 1
	kill -0 "$recorded_pid" 2>/dev/null || return 1
	[[ "$command_line" == *Chrome* || "$command_line" == *chrome* ]] || return 1
	[[ "$command_line" == *'--remote-debugging-port=9222'* ]] || return 1
	command -v launchctl >/dev/null 2>&1 || return 1
	# Active launcher ownership means the browser is not an orphaned safe target.
	launchctl print "$service" >/dev/null 2>&1 && return 1
	printf '%s\t%s\t%s\t%s\n' "$recorded_pid" "$elapsed" "$cpu" "$rss"
	return 0
}
detect_browser() {
	local metrics recorded_pid elapsed cpu rss
	metrics="$(evaluate_browser_safe)" || return 0
	IFS=$'\t' read -r recorded_pid elapsed cpu rss <<<"$metrics"
	add_safe "browser" "Chrome" "$(format_age "$(age_seconds "$elapsed")")" "$(format_cpu "$cpu")" "$(format_memory "$rss")" "Test browser; launcher exited" "$recorded_pid"
}

truncate_detail() { local value="$1" max="$2"; if ((max < 1)); then printf ''; elif ((${#value} > max)); then printf '%s…' "${value:0:max-1}"; else printf '%s' "$value"; fi; }
# Join non-empty fields with " · ". Skip placeholder em dashes from missing metrics.
join_detail_parts() {
	local out="" part
	for part in "$@"; do
		[[ -n "$part" && "$part" != "—" ]] || continue
		if [[ -z "$out" ]]; then out="$part"; else out="$out · $part"; fi
	done
	printf '%s' "$out"
}
# PID (when numeric) plus age/cpu/memory/reason for a single details cell.
format_entry_detail() {
	local pid="$1" age="$2" cpu="$3" memory="$4" reason="$5"
	local pid_part=""
	if [[ "$pid" =~ ^[0-9]+$ ]]; then pid_part="pid $pid"; fi
	join_detail_parts "$pid_part" "$age" "$cpu" "$memory" "$reason"
}
terminal_width() {
	local cols=""
	if [[ -n "${SLOPSTOP_WIDTH:-}" ]]; then
		printf '%s' "$SLOPSTOP_WIDTH"
		return
	fi
	if [[ -n "${COLUMNS:-}" && "$COLUMNS" =~ ^[1-9][0-9]*$ ]]; then
		printf '%s' "$COLUMNS"
		return
	fi
	if [[ -t 1 ]]; then
		if command -v tput >/dev/null 2>&1; then
			cols="$(tput cols 2>/dev/null || true)"
			if [[ -n "$cols" && "$cols" =~ ^[1-9][0-9]*$ ]]; then
				printf '%s' "$cols"
				return
			fi
		fi
		cols="$(stty size 2>/dev/null | awk '{print $2}' || true)"
		if [[ -n "$cols" && "$cols" =~ ^[1-9][0-9]*$ ]]; then
			printf '%s' "$cols"
			return
		fi
	fi
	printf '80'
}
detail_column_width() {
	local width="$1" detail_width
	detail_width=$((width - NAME_COLUMN_WIDTH - 2))
	((detail_width < 8)) && detail_width=8
	printf '%s\n' "$detail_width"
}
# Narrow terminals: name on one line, details indented under it.
needs_stacked_layout() {
	local width="$1"
	((width - NAME_COLUMN_WIDTH - 2 < MIN_DETAIL_WIDTH))
}
print_name_detail_row() {
	local name="$1" detail="$2" detail_width="$3" stacked="$4"
	if ((stacked)); then
		printf '%s\n' "$name"
		printf '  %s\n' "$(truncate_detail "$detail" "$detail_width")"
	else
		printf '%-*s  %s\n' "$NAME_COLUMN_WIDTH" "$name" "$(truncate_detail "$detail" "$detail_width")"
	fi
}
print_safe_section() {
	local width detail_width stacked=0 i detail safe_pid
	width="$(terminal_width)"
	if needs_stacked_layout "$width"; then
		stacked=1
		# Indented detail can use nearly the full terminal width.
		detail_width=$((width - 2))
		((detail_width < 8)) && detail_width=8
	else
		detail_width="$(detail_column_width "$width")"
	fi
	printf 'SlopStop\n\nSafe to stop\n'
	if ((${#safe_name[@]} == 0)); then
		printf '(none)\n\n'
		return
	fi
	for ((i = 0; i < ${#safe_name[@]}; i++)); do
		safe_pid="${safe_id[i]}"
		[[ "$safe_pid" == colima ]] && safe_pid=""
		detail="$(format_entry_detail "$safe_pid" "${safe_age[i]}" "${safe_cpu[i]}" "${safe_memory[i]}" "${safe_details[i]}")"
		print_name_detail_row "${safe_name[i]}" "$detail" "$detail_width" "$stacked"
	done
	printf '\n'
}
print_review_section() {
	local width detail_width stacked=0 i detail
	width="$(terminal_width)"
	if needs_stacked_layout "$width"; then
		stacked=1
		detail_width=$((width - 2))
		((detail_width < 8)) && detail_width=8
	else
		detail_width="$(detail_column_width "$width")"
	fi
	printf 'Needs review\n'
	if ((${#review_pid[@]} == 0)); then
		printf '(none)\n'
		return
	fi
	for ((i = 0; i < ${#review_pid[@]}; i++)); do
		detail="$(format_entry_detail "${review_pid[i]}" "${review_age[i]}" "${review_cpu[i]}" "${review_memory[i]}" "${review_details[i]}")"
		print_name_detail_row "${review_name[i]}" "$detail" "$detail_width" "$stacked"
	done
	printf '\n'
}
# Stop-mode instructions live in --help; keep scan output free of long footers.
print_footer() { :; }
# Revalidation is pure: never append to safe_* report arrays.
revalidate_colima() {
	colima_still_safe
}
revalidate_browser() {
	take_snapshot "$second_snapshot"
	current_snapshot="$second_snapshot"
	evaluate_browser_safe "$1" >/dev/null
}
stop_safe_candidates() {
	local i status=0 answer launcher candidate_count="${#safe_name[@]}"
	local colima_bin
	if [[ "$mode" == prompt ]]; then
		printf 'Stop all %d safe candidates? [y/N] ' "${#safe_name[@]}" >&2; IFS= read -r answer || answer=""
		case "$answer" in y|Y|yes|YES|Yes) ;; *) return 0 ;; esac
	fi
	for ((i=0; i<candidate_count; i++)); do
		if [[ "${safe_id[i]}" == colima ]]; then
			if ! revalidate_colima; then printf 'Skipped %s: state changed\n' "${safe_name[i]}"; continue; fi
			colima_bin="$(command -v colima 2>/dev/null || true)"
			if [[ -z "$colima_bin" ]] || ! "$colima_bin" stop; then
				printf 'Failed to stop Colima\n' >&2
				status=1
			else
				printf 'Stopped Colima\n'
			fi
		elif [[ "${safe_id[i]}" =~ ^[0-9]+$ ]]; then
			if ! revalidate_browser "${safe_id[i]}"; then
				printf 'Skipped %s (PID %s): state changed\n' "${safe_name[i]}" "${safe_id[i]}"
				continue
			fi
			launcher="$(command -v "${SLOPSTOP_BROWSER_LAUNCHER:-launch-browser}" 2>/dev/null || true)"
			if [[ -z "$launcher" ]] || ! "$launcher" --stop; then
				printf 'Failed to stop %s (PID %s)\n' "${safe_name[i]}" "${safe_id[i]}" >&2
				status=1
			else
				printf 'Stopped %s (PID %s)\n' "${safe_name[i]}" "${safe_id[i]}"
			fi
		fi
	done
	return "$status"
}

current_snapshot="$first_snapshot"
detect_colima
detect_browser
print_safe_section
collect_and_prepare_reviews
print_review_section
print_footer
if [[ "$mode" != scan && ${#safe_name[@]} -gt 0 ]]; then
	stop_safe_candidates
	exit $?
fi
