#!/usr/bin/env bash

# slopstop 0.1.0
# Concise, conservative reports of forgotten local developer workloads.

set -uo pipefail

readonly SLOPSTOP_VERSION="0.1.0"
readonly MIN_OLD_AGE_SECONDS=$((8 * 60 * 60))
readonly HIGH_CPU_AGE_SECONDS=$((60 * 60))
readonly REVIEW_CPU_PERCENT=5
readonly HIGH_CPU_PERCENT=20
readonly REVIEW_RSS_KB=$((2 * 1024 * 1024))
# Two-column layout: name min width + gap + details. PID/metrics live in details.
readonly NAME_COLUMN_WIDTH=12
readonly MIN_DETAIL_WIDTH=20
# Review CPU uses instantaneous ps %CPU as a fast heuristic (review-only).

mode="scan"
tmp_dir=""
current_user=""
ps_command=""
sort_command=""
progress_active=0
progress_shown_marked=0
gradle_idle_count=0
mvnd_idle_count=0
# Space-padded PID set — no per-row external grep.
excluded_review_pids=" "
safe_name=(); safe_age=(); safe_cpu=(); safe_memory=(); safe_details=(); safe_id=()
review_pid=(); review_name=(); review_age=(); review_cpu=(); review_memory=(); review_details=(); review_kill=()

usage() {
	printf '%s\n' \
		"SlopStop $SLOPSTOP_VERSION" \
		"Usage: slopstop [--stop|--stop-safe|--help]" \
		"  (default)   Scan and report only; never changes machine state." \
		"  --stop      Stop all safe candidates after one y/N confirmation." \
		"  --stop-safe Stop all safe candidates without prompting." \
		"  --help      Show this help." \
		"Review candidates are never stopped automatically."
}
fail() { printf 'Error: %s\n' "$1" >&2; exit 1; }
cleanup() {
	clear_scan_progress
	[[ -n "$tmp_dir" && -d "$tmp_dir" ]] && rm -rf -- "$tmp_dir"
}
trap cleanup EXIT

mark_progress_shown() {
	if ((progress_shown_marked == 0)) && [[ -n "${SLOPSTOP_PROGRESS_SHOWN_FILE:-}" ]]; then
		: >"$SLOPSTOP_PROGRESS_SHOWN_FILE"
		progress_shown_marked=1
	fi
}
show_scan_progress() {
	local label="$1"
	mark_progress_shown
	[[ -t 1 ]] || return 0
	printf '\r\033[2K%s' "$label"
	progress_active=1
}
clear_scan_progress() {
	if ((progress_active)); then
		printf '\r\033[2K'
		progress_active=0
	fi
	if [[ -n "${SLOPSTOP_PROGRESS_CLEARED_FILE:-}" ]]; then
		: >"$SLOPSTOP_PROGRESS_CLEARED_FILE"
	fi
}
interrupt() {
	clear_scan_progress
	trap - INT
	exit 130
}
trap interrupt INT

while (($# > 0)); do
	case "$1" in
		--stop) mode="prompt" ;;
		--stop-safe) mode="safe" ;;
		--help|-h) usage; exit 0 ;;
		*) usage >&2; exit 1 ;;
	esac
	shift
done

[[ "$(uname -s)" == "Darwin" ]] || fail "SlopStop supports macOS only"
current_user="$(id -un 2>/dev/null || true)"
[[ -n "$current_user" ]] || fail "could not determine current user"
ps_command="$(command -v ps 2>/dev/null || true)"
[[ -n "$ps_command" ]] || fail "ps is required"
sort_command="$(command -v sort 2>/dev/null || true)"
[[ -n "$sort_command" ]] || fail "sort is required"

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/slopstop.XXXXXX")" || fail "could not create temporary directory"
process_snapshot="$tmp_dir/processes"
launchctl_services="$tmp_dir/launchctl-services"

take_snapshot() {
	local destination="$1"
	"$ps_command" -axo user= -o pid= -o ppid= -o etime= -o '%cpu=' -o rss= -o command= >"$destination" || fail "could not read the process table"
}

collect_and_prepare_reviews() {
	show_scan_progress "Preparing report..."
	collect_launchctl_services
	take_snapshot "$process_snapshot"
	collect_reviews "$process_snapshot"
	clear_scan_progress
}

format_age() {
	local seconds="$1"
	if [[ "$seconds" == "—" ]]; then printf '—'
	elif ((seconds >= 86400)); then printf '%dd' $((seconds / 86400))
	elif ((seconds >= 3600)); then printf '%dh' $((seconds / 3600))
	else printf '%dm' $((seconds / 60)); fi
}
format_memory() {
	local kb="$1" tenths
	if [[ "$kb" == "—" ]]; then printf '—'
	elif ((kb >= 1048576)); then
		tenths=$(( (kb * 10 + 524288) / 1048576 ))
		printf '%d.%d GB' $((tenths / 10)) $((tenths % 10))
	elif ((kb >= 1024)); then
		printf '%d MB' $(( (kb + 512) / 1024 ))
	else
		printf '%d KB' "$kb"
	fi
}
format_cpu() { [[ "$1" == "—" ]] && printf '—' || printf '%s%%' "$1"; }

# Detached debug browsers only (main binary + headless/remote-debugging).
is_detached_browser() {
	local command_line="$1"
	[[ "$command_line" == *'Chrome Helper'* || "$command_line" == *'Chromium Helper'* ]] && return 1
	[[ "$command_line" == *crashpad* || "$command_line" == *'--type='* ]] && return 1
	[[ "$command_line" == *--remote-debugging-* || "$command_line" == *--headless* ]] || return 1
	case "$command_line" in
		'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome '*) return 0 ;;
		'/Applications/Chromium.app/Contents/MacOS/Chromium '*) return 0 ;;
		'/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge '*) return 0 ;;
		'/Applications/Brave Browser.app/Contents/MacOS/Brave Browser '*) return 0 ;;
	esac
	return 1
}
browser_display_name() {
	local command_line="$1"
	case "$command_line" in
		*Edge*) printf 'Edge' ;;
		*Brave*) printf 'Brave' ;;
		*Chromium*) printf 'Chromium' ;;
		*) printf 'Chrome' ;;
	esac
}

# launchctl submit-style jobs (launch-browser) run the browser as a child of a
# per-instance job. Snapshot launchctl's job table once so a detached browser
# can print a kill hint (launchctl remove <label>). Only launch-browser labels
# are accepted; labels are treated as data, never shell syntax.
collect_launchctl_services() {
	command -v launchctl >/dev/null 2>&1 || return 0
	launchctl list 2>/dev/null >"$launchctl_services" || true
}
# Exact numeric PID match in the cached job table; accept only launch-browser
# labels (xyz.pvrlabs.browser.*) made of conservative characters.
launchctl_label_for_pid() {
	local pid="$1" line label
	[[ -s "$launchctl_services" ]] || return 1
	while IFS= read -r line; do
		[[ "$line" =~ ^([0-9]+)[[:space:]]+[0-9-]+[[:space:]]+(.+)$ ]] || continue
		[[ "${BASH_REMATCH[1]}" == "$pid" ]] || continue
		label="${BASH_REMATCH[2]}"
		[[ "$label" =~ ^xyz\.pvrlabs\.browser\.[A-Za-z0-9._-]+$ ]] || continue
		printf '%s\n' "$label"
		return 0
	done <"$launchctl_services"
	return 1
}
# Match by browser PID first, then its parent (the launch-browser wrapper job).
launchctl_label_for_browser() {
	local pid="$1" ppid="$2" label
	if label="$(launchctl_label_for_pid "$pid")"; then
		printf '%s\n' "$label"
		return 0
	fi
	if label="$(launchctl_label_for_pid "$ppid")"; then
		printf '%s\n' "$label"
		return 0
	fi
	return 1
}

# One main app binary each; normal resource gates apply (not "always on").
is_container_app_review() {
	local command_line="$1"
	[[ "$command_line" == *'--type='* || "$command_line" == *Helper* || "$command_line" == *crashpad* ]] && return 1
	case "$command_line" in
		'/Applications/Docker.app/Contents/MacOS/Docker Desktop'|'/Applications/Docker.app/Contents/MacOS/Docker Desktop '*) return 0 ;;
		'/Applications/OrbStack.app/Contents/MacOS/OrbStack'|'/Applications/OrbStack.app/Contents/MacOS/OrbStack '*) return 0 ;;
	esac
	return 1
}
container_app_display_name() {
	local command_line="$1"
	case "$command_line" in
		*OrbStack*) printf 'OrbStack' ;;
		*) printf 'Docker Desktop' ;;
	esac
}

# python -m http.server: age-only review (≥8h), never safe-to-stop.
# Generic python apps are not matched; only the stdlib module form.
is_python_http_server() {
	local command_line="$1"
	[[ "$command_line" == *'-m http.server'* ]]
}
# Port from positional arg after http.server; skip option values. Default 8000.
python_http_server_port() {
	local command_line="$1" rest token prev="" port=""
	rest="${command_line#*http.server}"
	for token in $rest; do
		case "$prev" in
			-b|--bind|-d|--directory|-p|--protocol) prev="$token"; continue ;;
		esac
		case "$token" in
			--bind=*|--directory=*|--protocol=*) prev="$token"; continue ;;
			-b|--bind|-d|--directory|-p|--protocol) prev="$token"; continue ;;
		esac
		if [[ "$token" =~ ^[1-9][0-9]{0,4}$ ]] && ((10#$token <= 65535)); then
			port="$token"
		fi
		prev="$token"
	done
	printf '%s\n' "${port:-8000}"
}

# Raw qemu/Virtualization is intentionally not listed (not actionable).
is_allowlisted_process() {
	local name="$1" command_line="$2"
	[[ "$command_line" == *opencode* ]] && return 0
	case "$name:$command_line" in
		opencode:*|*:*bun*opencode*) return 0 ;;
		java:*GradleDaemon*|java:*org.gradle.launcher.daemon*|java:*gradle*daemon*|java:*KotlinCompileDaemon*|java:*kotlin-daemon*|java:*org.jetbrains.kotlin.daemon*|java:*mvnd*|java:*maven.daemon*) return 0 ;;
		mvnd:*|gradle:*|kotlin-daemon:*) return 0 ;;
		vite:*|next:*|next-server:*|webpack:*|webpack-dev-server:*|nodemon:*|air:*|cargo-watch:*) return 0 ;;
		node:*vite*|node:*next*|node:*webpack*|node:*nodemon*|bun:*vite*|bun:*next*|bun:*webpack*|bun:*nodemon*) return 0 ;;
		*:*'go run '*|*:*'cargo watch'*|cargo:*watch*) return 0 ;;
	esac
	return 1
}
# Obvious macOS services are not useful generic review candidates.
# This exclusion applies only to the generic old/high-CPU fallback.
is_generic_system_process() {
	local name="$1" command_line="$2"

	case "$command_line" in
		/System/*|/usr/libexec/*|/usr/sbin/*|/sbin/*) return 0 ;;
	esac

	case "$name" in
		kernel_task|WindowServer|launchd) return 0 ;;
	esac

	return 1
}
# Return 0 when the command line belongs to a Chrome, Chromium, Edge, or Brave
# app bundle. Browser-helper exclusions are scoped to these bundles so unrelated
# processes using similar options (--type=, crashpad) are not hidden.
is_browser_app_process() {
	local command_line="$1"
	case "$command_line" in
		'/Applications/Google Chrome.app/'*|'/Applications/Chromium.app/'*|'/Applications/Microsoft Edge.app/'*|'/Applications/Brave Browser.app/'*) return 0 ;;
	esac
	return 1
}
# Deliberately excluded from review regardless of age or CPU: interactive
# browser main binaries, browser helpers, container-app backends/helpers, and
# raw VM host processes (qemu, Virtualization.framework). "Not recognized" by
# the detectors above must not become eligible for the generic fallback; these
# processes are explicitly recognized as not listed.
is_not_listed_process() {
	local name="$1" command_line="$2"

	case "$command_line" in
		/Applications/Docker.app/*|/Applications/OrbStack.app/*) return 0 ;;
		/System/Library/Frameworks/Virtualization.framework/*) return 0 ;;
	esac

	case "$name" in
		qemu-system-*|qemu-kvm|com.docker.*|com.orbstack.*) return 0 ;;
	esac

	if is_browser_app_process "$command_line"; then
		case "$command_line" in
			'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'*|'/Applications/Chromium.app/Contents/MacOS/Chromium'*|'/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge'*|'/Applications/Brave Browser.app/Contents/MacOS/Brave Browser'*) return 0 ;;
			*crashpad*|*--type=*) return 0 ;;
		esac
		case "$name" in
			*'Chrome Helper'*|*'Chromium Helper'*|*'Edge Helper'*|*'Brave Helper'*) return 0 ;;
		esac
	fi

	return 1
}
is_review_candidate() {
	local age="$1" cpu_int="${2%.*}" rss="$3"
	((age >= MIN_OLD_AGE_SECONDS && cpu_int >= REVIEW_CPU_PERCENT)) && return 0
	((age >= MIN_OLD_AGE_SECONDS && rss >= REVIEW_RSS_KB)) && return 0
	((age >= HIGH_CPU_AGE_SECONDS && cpu_int >= HIGH_CPU_PERCENT)) && return 0
	return 1
}
exclude_review_pid() {
	excluded_review_pids+=" $1 "
}
is_excluded_review_pid() {
	[[ "$excluded_review_pids" == *" $1 "* ]]
}

collect_reviews() {
	local snapshot="$1" user pid ppid elapsed cpu rss command_line age name
	local value days hours minutes seconds first reason cpu_int launch_label
	local formatted_age formatted_cpu formatted_memory
	: >"$tmp_dir/reviews"
	while read -r user pid ppid elapsed cpu rss command_line; do
		[[ -n "${pid:-}" && "$pid" != "PID" ]] || continue
		[[ "$user" == "$current_user" ]] || continue
		[[ "$pid" =~ ^[0-9]+$ && "$rss" =~ ^[0-9]+$ ]] || continue
		[[ "$cpu" =~ ^[0-9]+([.][0-9]+)?$ ]] || continue
		is_excluded_review_pid "$pid" && continue

		value="$elapsed" days=0 hours=0 minutes=0 seconds=0
		if [[ "$value" == *-* ]]; then days="${value%%-*}"; value="${value#*-}"; fi
		IFS=: read -r hours minutes seconds <<<"$value"
		if [[ -z "${seconds:-}" ]]; then seconds="$minutes"; minutes="$hours"; hours=0; fi
		age=$((10#$days * 86400 + 10#$hours * 3600 + 10#$minutes * 60 + 10#$seconds))
		cpu_int="${cpu%.*}"

		first="${command_line%% *}"
		name="${first##*/}"
		launch_label=""
		if is_detached_browser "$command_line"; then
			name="$(browser_display_name "$command_line")"
			reason="detached debug browser"
			launch_label="$(launchctl_label_for_browser "$pid" "$ppid")" || launch_label=""
		elif is_container_app_review "$command_line"; then
			is_review_candidate "$age" "$cpu" "$rss" || continue
			name="$(container_app_display_name "$command_line")"
			reason="container runtime"
		elif is_python_http_server "$command_line"; then
			# Age-only: idle leftovers are the useful signal; never auto-stop.
			((age >= MIN_OLD_AGE_SECONDS)) || continue
			reason="old dev server; port $(python_http_server_port "$command_line")"
		else
			if is_allowlisted_process "$name" "$command_line"; then
				is_review_candidate "$age" "$cpu" "$rss" || continue

				if ((age >= MIN_OLD_AGE_SECONDS && cpu_int >= REVIEW_CPU_PERCENT)) \
					|| ((age >= HIGH_CPU_AGE_SECONDS && cpu_int >= HIGH_CPU_PERCENT)); then
					reason="elevated CPU"
				else
					reason="high memory developer workload"
				fi
			else
				[[ "$pid" == "$$" ]] && continue
				is_not_listed_process "$name" "$command_line" && continue
				is_generic_system_process "$name" "$command_line" && continue
				((age >= MIN_OLD_AGE_SECONDS && cpu_int >= HIGH_CPU_PERCENT)) || continue
				reason="old high-CPU process"
			fi
		fi

		printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$pid" "$name" "$age" "$cpu" "$rss" "$reason" "$launch_label" >>"$tmp_dir/reviews"
	done <"$snapshot"
	while IFS=$'\t' read -r pid name age cpu rss detail kill_hint; do
		formatted_age="$(format_age "$age")"
		formatted_cpu="$(format_cpu "$cpu")"
		formatted_memory="$(format_memory "$rss")"
		review_pid+=("$pid")
		review_name+=("$name")
		review_age+=("$formatted_age")
		review_cpu+=("$formatted_cpu")
		review_memory+=("$formatted_memory")
		review_details+=("$detail")
		review_kill+=("$kill_hint")
	done < <(LC_ALL=C "$sort_command" -t $'\t' -k4,4nr "$tmp_dir/reviews")
}
add_safe() {
	safe_name+=("$1"); safe_age+=("$2"); safe_cpu+=("$3"); safe_memory+=("$4"); safe_details+=("$5"); safe_id+=("$6")
}

# Colima: empty/zero containers on its own runtime; refuse k8s.
# Status field: accept Running, or omit entirely. Some Colima versions leave
# status out of successful `status --json` while the VM is up; requiring
# status==Running would silently drop the primary detector on those builds.
# Explicit non-Running values (Stopped, Starting, …) remain unsafe.
# Safety still requires a successful status query, known runtime, and a
# successful empty container listing (k8s.io must succeed and be empty for containerd).
colima_still_safe() {
	local colima status_json status runtime profile context runtime_command containers
	local k8s_containers
	colima="$(command -v colima 2>/dev/null || true)"; [[ -n "$colima" ]] || return 1
	status_json="$("$colima" status --json 2>/dev/null)" || return 1
	status_json="$(tr -d '[:space:]' <<<"$status_json")"
	status="$(sed -n 's/.*"status"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' <<<"$status_json")"
	[[ -z "$status" || "$status" == Running ]] || return 1
	runtime="$(sed -n 's/.*"runtime"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' <<<"$status_json")"
	profile="$(sed -n 's/.*"profile"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' <<<"$status_json")"
	[[ -n "$profile" ]] || profile="default"
	if [[ "$profile" == default ]]; then context="colima"; else context="colima-$profile"; fi
	if [[ "$status_json" == *'"kubernetes":true'* || "$status_json" == *'"kubernetes":'*'true'* || "$runtime" == *k3s* || "$runtime" == *+k3s* ]]; then
		return 1
	fi
	case "$runtime" in
		docker) runtime_command="$(command -v docker 2>/dev/null || true)" ;;
		containerd) runtime_command="$(command -v nerdctl 2>/dev/null || true)" ;;
		*) return 1 ;;
	esac
	[[ -n "$runtime_command" ]] || return 1
	if [[ "$runtime" == docker ]]; then
		containers="$("$runtime_command" --context "$context" ps -q 2>/dev/null)" || return 1
	else
		containers="$("$runtime_command" --address "unix://${HOME:-}/.colima/${profile}/containerd.sock" ps -q 2>/dev/null)" || return 1
		# Query must succeed; failure is not "empty".
		k8s_containers="$("$runtime_command" --address "unix://${HOME:-}/.colima/${profile}/containerd.sock" --namespace k8s.io ps -q 2>/dev/null)" || return 1
		[[ -z "$k8s_containers" ]] || return 1
	fi
	[[ -z "$containers" ]] || return 1
	return 0
}
detect_colima() {
	colima_still_safe || return 0
	add_safe "Colima" "—" "—" "—" "Running; no active containers" "colima"
}

daemon_status_kind() {
	case "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')" in
		IDLE) printf 'idle' ;;
		BUSY) printf 'busy' ;;
		STOPPED|STOPPING) printf 'stopped' ;;
		*) printf '' ;;
	esac
}

# Whitelist-only status parser. Gradle: PID STATUS [INFO]. mvnd: PID Uptime Status.
daemon_status_is_all_idle() {
	local status_out="$1" idle_pids_file="$2"
	local line pid a b kind idle=0 busy=0 unknown=0
	: >"$idle_pids_file"
	while IFS= read -r line || [[ -n "$line" ]]; do
		[[ -n "${line// }" ]] || continue
		[[ "$line" =~ ^[[:space:]]*PID[[:space:]]+STATUS([[:space:]]|$) ]] && continue
		[[ "$line" =~ ^[[:space:]]*PID[[:space:]]+Uptime[[:space:]]+Status([[:space:]]|$) ]] && continue
		[[ "$line" =~ ^[Nn]o[[:space:]].*[Rr]unning\.?$ ]] && continue
		[[ "$line" =~ ^[Nn]o[[:space:]]+[Dd]aemons([[:space:]]|$) ]] && continue
		if [[ "$line" =~ ^[[:space:]]*([0-9]+)[[:space:]]+([^[:space:]]+)([[:space:]]+([^[:space:]]+))? ]]; then
			pid="${BASH_REMATCH[1]}"
			a="${BASH_REMATCH[2]}"
			b="${BASH_REMATCH[4]:-}"
			kind="$(daemon_status_kind "$a")"
			if [[ -z "$kind" && -n "$b" ]]; then
				kind="$(daemon_status_kind "$b")"
			fi
			case "$kind" in
				idle)
					idle=$((idle + 1))
					printf '%s\n' "$pid" >>"$idle_pids_file"
					;;
				busy) busy=$((busy + 1)) ;;
				stopped) ;;
				*) unknown=$((unknown + 1)) ;;
			esac
		else
			unknown=$((unknown + 1))
		fi
	done <<<"$status_out"
	((idle > 0 && busy == 0 && unknown == 0)) || return 1
	printf '%s\n' "$idle"
	return 0
}

gradle_still_safe() {
	local gradle status_out idle_n
	gradle="$(command -v gradle 2>/dev/null || true)"
	[[ -n "$gradle" ]] || return 1
	status_out="$("$gradle" --status 2>/dev/null)" || return 1
	idle_n="$(daemon_status_is_all_idle "$status_out" "$tmp_dir/gradle_idle_pids")" || return 1
	gradle_idle_count="$idle_n"
	return 0
}
detect_gradle() {
	local pid
	gradle_idle_count=0
	gradle_still_safe || return 0
	while IFS= read -r pid; do
		[[ -n "$pid" ]] && exclude_review_pid "$pid"
	done <"$tmp_dir/gradle_idle_pids"
	add_safe "Gradle" "—" "—" "—" "${gradle_idle_count} idle daemon(s); gradle --stop" "gradle"
}

mvnd_still_safe() {
	local mvnd status_out idle_n
	mvnd="$(command -v mvnd 2>/dev/null || true)"
	[[ -n "$mvnd" ]] || return 1
	status_out="$("$mvnd" --status 2>/dev/null)" || return 1
	idle_n="$(daemon_status_is_all_idle "$status_out" "$tmp_dir/mvnd_idle_pids")" || return 1
	mvnd_idle_count="$idle_n"
	return 0
}
detect_mvnd() {
	local pid
	mvnd_idle_count=0
	mvnd_still_safe || return 0
	while IFS= read -r pid; do
		[[ -n "$pid" ]] && exclude_review_pid "$pid"
	done <"$tmp_dir/mvnd_idle_pids"
	add_safe "mvnd" "—" "—" "—" "${mvnd_idle_count} idle daemon(s); mvnd --stop" "mvnd"
}

truncate_detail() {
	local value="$1" max="$2"
	if ((max < 1)); then printf ''
	elif ((${#value} > max)); then
		if ((max <= 3)); then printf '%s' "${value:0:max}"
		else printf '%s...' "${value:0:max-3}"
		fi
	else printf '%s' "$value"
	fi
}
join_detail_parts() {
	local out="" part
	for part in "$@"; do
		[[ -n "$part" && "$part" != "—" ]] || continue
		if [[ -z "$out" ]]; then out="$part"; else out="$out · $part"; fi
	done
	printf '%s' "$out"
}
format_entry_detail() {
	local pid="$1" age="$2" cpu="$3" memory="$4" reason="$5"
	local pid_part=""
	if [[ "$pid" =~ ^[0-9]+$ ]]; then pid_part="pid $pid"; fi
	join_detail_parts "$pid_part" "$age" "$cpu" "$memory" "$reason"
}
terminal_width() {
	local cols=""
	if [[ -n "${SLOPSTOP_WIDTH:-}" ]]; then
		printf '%s' "$SLOPSTOP_WIDTH"
		return
	fi
	if [[ -n "${COLUMNS:-}" && "$COLUMNS" =~ ^[1-9][0-9]*$ ]]; then
		printf '%s' "$COLUMNS"
		return
	fi
	if [[ -t 1 ]]; then
		if command -v tput >/dev/null 2>&1; then
			cols="$(tput cols 2>/dev/null || true)"
			if [[ -n "$cols" && "$cols" =~ ^[1-9][0-9]*$ ]]; then
				printf '%s' "$cols"
				return
			fi
		fi
		cols="$(stty size 2>/dev/null | awk '{print $2}' || true)"
		if [[ -n "$cols" && "$cols" =~ ^[1-9][0-9]*$ ]]; then
			printf '%s' "$cols"
			return
		fi
	fi
	printf '80'
}

print_name_detail_row() {
	local name="$1" detail="$2" term_width="$3"
	local name_w=${#name} detail_w stacked_detail_w name_max
	((name_w < NAME_COLUMN_WIDTH)) && name_w=$NAME_COLUMN_WIDTH
	detail_w=$((term_width - name_w - 2))
	if ((detail_w < MIN_DETAIL_WIDTH)); then
		name_max=$term_width
		((name_max < 1)) && name_max=1
		stacked_detail_w=$((term_width - 2))
		((stacked_detail_w < 8)) && stacked_detail_w=8
		printf '%s\n' "$(truncate_detail "$name" "$name_max")"
		printf '  %s\n' "$(truncate_detail "$detail" "$stacked_detail_w")"
	else
		printf '%-*s  %s\n' "$name_w" "$name" "$(truncate_detail "$detail" "$detail_w")"
	fi
}
# Two-space indented continuation line, truncated to fit within term_width.
print_continuation_line() {
	local text="$1" term_width="$2"
	local avail=$((term_width - 2))
	((avail < 1)) && avail=1
	printf '  %s\n' "$(truncate_detail "$text" "$avail")"
}
print_safe_section() {
	local width i detail safe_pid header
	width="$(terminal_width)"
	header='SlopStop - finds forgotten processes wasting CPU and memory'
	if ((${#header} > width)); then
		printf '%s\n' "$(truncate_detail "$header" "$width")"
	else
		printf '%s\n' "$header"
	fi
	printf '\n'
	if ((${#safe_name[@]} == 0)); then
		printf 'Safe to stop\n(none)\n\n'
		return
	fi
	header='Safe to stop (use --stop-safe to stop without prompting)'
	if ((${#header} > width)); then
		printf 'Safe to stop\n'
		printf '  %s\n' "$(truncate_detail 'use --stop-safe to stop without prompting' $((width > 2 ? width - 2 : width)))"
	else
		printf '%s\n' "$header"
	fi
	for ((i = 0; i < ${#safe_name[@]}; i++)); do
		safe_pid="${safe_id[i]}"
		[[ "$safe_pid" == colima || "$safe_pid" == gradle || "$safe_pid" == mvnd ]] && safe_pid=""
		detail="$(format_entry_detail "$safe_pid" "${safe_age[i]}" "${safe_cpu[i]}" "${safe_memory[i]}" "${safe_details[i]}")"
		print_name_detail_row "${safe_name[i]}" "$detail" "$width"
	done
	printf '\n'
}
print_review_section() {
	local width i detail kill_hint
	width="$(terminal_width)"
	printf 'Needs review\n'
	if ((${#review_pid[@]} == 0)); then
		printf '(none)\n'
		return
	fi
	for ((i = 0; i < ${#review_pid[@]}; i++)); do
		detail="$(format_entry_detail "${review_pid[i]}" "${review_age[i]}" "${review_cpu[i]}" "${review_memory[i]}" "${review_details[i]}")"
		print_name_detail_row "${review_name[i]}" "$detail" "$width"
		kill_hint="${review_kill[i]:-}"
		if [[ -n "$kill_hint" ]]; then
			print_continuation_line "kill: launchctl remove $kill_hint" "$width"
		fi
	done
	printf '\n'
}
print_footer() { :; }

revalidate_colima() { colima_still_safe; }
revalidate_gradle() { gradle_still_safe; }
revalidate_mvnd() { mvnd_still_safe; }

stop_safe_candidates() {
	local i status=0 answer candidate_count="${#safe_name[@]}"
	local colima_bin gradle_bin mvnd_bin
	if [[ "$mode" == prompt ]]; then
		printf 'Stop all %d safe candidates? [y/N] ' "${#safe_name[@]}" >&2; IFS= read -r answer || answer=""
		case "$answer" in y|Y|yes|YES|Yes) ;; *) return 0 ;; esac
	fi
	for ((i=0; i<candidate_count; i++)); do
		if [[ "${safe_id[i]}" == colima ]]; then
			if ! revalidate_colima; then printf 'Skipped %s: state changed\n' "${safe_name[i]}"; continue; fi
			colima_bin="$(command -v colima 2>/dev/null || true)"
			if [[ -z "$colima_bin" ]] || ! "$colima_bin" stop; then
				printf 'Failed to stop Colima\n' >&2
				status=1
			else
				printf 'Stopped Colima\n'
			fi
		elif [[ "${safe_id[i]}" == gradle ]]; then
			if ! revalidate_gradle; then printf 'Skipped %s: state changed\n' "${safe_name[i]}"; continue; fi
			gradle_bin="$(command -v gradle 2>/dev/null || true)"
			if [[ -z "$gradle_bin" ]] || ! "$gradle_bin" --stop; then
				printf 'Failed to stop Gradle daemons\n' >&2
				status=1
			else
				printf 'Stopped Gradle daemons\n'
			fi
		elif [[ "${safe_id[i]}" == mvnd ]]; then
			if ! revalidate_mvnd; then printf 'Skipped %s: state changed\n' "${safe_name[i]}"; continue; fi
			mvnd_bin="$(command -v mvnd 2>/dev/null || true)"
			if [[ -z "$mvnd_bin" ]] || ! "$mvnd_bin" --stop; then
				printf 'Failed to stop mvnd daemons\n' >&2
				status=1
			else
				printf 'Stopped mvnd daemons\n'
			fi
		fi
	done
	return "$status"
}

