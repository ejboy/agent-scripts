#!/bin/sh
# DEPRECATED: repo-map has been renamed to repolink.
# Retained for compatibility with existing scripts and agent skills.
# Use `repolink` for all new usage.

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
	printf "%s\n\n" "repo-map is deprecated; use 'repolink' instead."
fi

exec repolink "$@"
