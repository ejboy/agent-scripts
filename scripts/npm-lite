#!/usr/bin/env bash

# npm-lite 0.2.0
# Compact npm output for selected test and verification workflows.
# https://github.com/ejboy/agent-scripts

set -uo pipefail

readonly AGENT_SCRIPTS_VERSION="0.2.0"
readonly FAILURE_EXCERPT_BYTES=7000
readonly LOG_RETENTION_MINUTES=10080
: "$AGENT_SCRIPTS_VERSION"

started_at="$(date +%s)"
child_pid=""
log_dir=""
log_file=""
visible_file=""

fail() {
	printf 'Error: %s\n' "$1" >&2
	exit 2
}

warn() {
	printf 'Warning: %s\n' "$1" >&2
}

prune_old_logs() {
	find "$log_dir" -type f -name 'npm-lite.*' -mmin "+$LOG_RETENTION_MINUTES" \
		-exec rm -f -- {} + 2>/dev/null || true
}

terminate_process_tree() {
	local pid="$1" signal="$2" child
	while read -r child; do
		[[ -n "$child" ]] || continue
		terminate_process_tree "$child" "$signal"
	done < <(pgrep -P "$pid" 2>/dev/null || true)
	kill "-$signal" "$pid" 2>/dev/null || true
}

forward_signal() {
	local signal="$1" exit_status="$2"
	trap - INT TERM
	if [[ -n "$child_pid" ]]; then
		terminate_process_tree "$child_pid" "$signal"
		wait "$child_pid" 2>/dev/null || true
	fi
	rm -f -- "$visible_file" 2>/dev/null || true
	prune_old_logs
	exit "$exit_status"
}

extract_test_count() {
	awk '
		match($0, /[0-9]+ passing/) {
			value = substr($0, RSTART, RLENGTH)
			sub(/ passing$/, "", value)
			count = value
		}
		match($0, /Tests:[[:space:]]+[0-9]+ passed/) {
			value = substr($0, RSTART, RLENGTH)
			sub(/^Tests:[[:space:]]+/, "", value)
			sub(/ passed$/, "", value)
			count = value
		}
		match($0, /Tests[[:space:]]+[0-9]+ passed/) {
			value = substr($0, RSTART, RLENGTH)
			sub(/^Tests[[:space:]]+/, "", value)
			sub(/ passed$/, "", value)
			count = value
		}
		END {
			if (count != "") {
				print count
			}
		}
	' "$1"
}

mode="passthrough"
if (($# == 2)) && [[ "$1" == "run" ]]; then
	case "$2" in
		verify|test:unit)
			mode="compact"
			;;
	esac
fi

if [[ "$mode" == "passthrough" ]]; then
	exec npm "$@"
fi

log_dir="$PWD/.agent-logs/npm"
original_umask="$(umask)"
umask 077
mkdir -p "$log_dir" || fail "could not create npm log directory: $log_dir"
if ! log_file="$(mktemp "$log_dir/npm-lite.XXXXXX")"; then
	umask "$original_umask"
	rmdir "$log_dir" 2>/dev/null || true
	rmdir "$PWD/.agent-logs" 2>/dev/null || true
	fail "could not create npm log in: $log_dir"
fi
if ! visible_file="$(mktemp "$log_dir/npm-lite-visible.XXXXXX")"; then
	rm -f -- "$log_file" || warn "could not remove incomplete npm log: $log_file"
	umask "$original_umask"
	rmdir "$log_dir" 2>/dev/null || true
	rmdir "$PWD/.agent-logs" 2>/dev/null || true
	fail "could not create npm summary file in: $log_dir"
fi
umask "$original_umask"
trap 'forward_signal INT 130' INT
trap 'forward_signal TERM 143' TERM
npm "$@" > "$log_file" 2>&1 &
child_pid=$!
wait "$child_pid"
status=$?
child_pid=""
trap - INT TERM
duration="$(($(date +%s) - started_at))"
prune_old_logs

if ((status == 0)); then
	test_count="$(extract_test_count "$log_file")"
	if [[ -n "$test_count" ]]; then
		printf 'PASS · %s tests · %s s\n' "$test_count" "$duration" > "$visible_file"
	else
		printf 'PASS · %s s\n' "$duration" > "$visible_file"
	fi
else
	printf 'FAIL · exit %d · %s s\n\n' "$status" "$duration" > "$visible_file"
	printf '[failure diagnostics limited to the last 80 lines and %d bytes]\n' "$FAILURE_EXCERPT_BYTES" >> "$visible_file"
	tail -n 80 "$log_file" | tail -c "$FAILURE_EXCERPT_BYTES" >> "$visible_file"
	printf '\nLog: %s\n' "$log_file" >> "$visible_file"
fi

command cat "$visible_file"
rm -f -- "$visible_file" || warn "could not remove npm summary file: $visible_file"
if ((status == 0)); then
	if rm -f -- "$log_file"; then
		rmdir "$log_dir" 2>/dev/null || true
		rmdir "$PWD/.agent-logs" 2>/dev/null || true
	else
		warn "could not remove successful npm log: $log_file"
	fi
fi
exit "$status"
