#!/usr/bin/env bash

# npm-lite 0.2.0
# Compact npm output for selected test and verification workflows.
# https://github.com/ejboy/agent-scripts

set -uo pipefail

readonly AGENT_SCRIPTS_VERSION="0.2.0"
readonly FAILURE_EXCERPT_BYTES=7000
readonly LOG_RETENTION_MINUTES=10080
: "$AGENT_SCRIPTS_VERSION"

started_at="$(date +%s)"
child_pid=""
log_dir=""
log_file=""
visible_file=""

fail() {
	printf 'Error: %s\n' "$1" >&2
	exit 2
}

warn() {
	printf 'Warning: %s\n' "$1" >&2
}

prune_old_logs() {
	find "$log_dir" -type f -name 'npm-lite.*' -mmin "+$LOG_RETENTION_MINUTES" \
		-exec rm -f -- {} + 2>/dev/null || true
}

terminate_process_tree() {
	local pid="$1" signal="$2" child
	while read -r child; do
		[[ -n "$child" ]] || continue
		terminate_process_tree "$child" "$signal"
	done < <(pgrep -P "$pid" 2>/dev/null || true)
	kill "-$signal" "$pid" 2>/dev/null || true
}

forward_signal() {
	local signal="$1" exit_status="$2"
	trap - INT TERM
	if [[ -n "$child_pid" ]]; then
		terminate_process_tree "$child_pid" "$signal"
		wait "$child_pid" 2>/dev/null || true
	fi
	rm -f -- "$visible_file" 2>/dev/null || true
	prune_old_logs
	exit "$exit_status"
}

extract_test_count() {
	awk '
		{
			line = $0
			gsub(sprintf("%c", 27) "\\[[0-9;?]*[ -/]*[@-~]", "", line)
		}
		match(line, /[0-9]+ passing/) {
			value = substr(line, RSTART, RLENGTH)
			sub(/ passing$/, "", value)
			count = value
		}
		match(line, /Tests:[[:space:]]+[0-9]+ passed/) {
			value = substr(line, RSTART, RLENGTH)
			sub(/^Tests:[[:space:]]+/, "", value)
			sub(/ passed$/, "", value)
			count = value
		}
		match(line, /Tests[[:space:]]+[0-9]+ passed/) {
			value = substr(line, RSTART, RLENGTH)
			sub(/^Tests[[:space:]]+/, "", value)
			sub(/ passed$/, "", value)
			count = value
		}
		match(line, /passing:[[:space:]]+[0-9]+/) {
			value = substr(line, RSTART, RLENGTH)
			sub(/^passing:[[:space:]]+/, "", value)
			count = value
		}
		END {
			if (count != "") {
				print count
			}
		}
	' "$1"
}

extract_failure_context() {
	awk '
		function copy_previous(target_lines, target_numbers,    first, i, slot) {
			first = NR > 2 ? NR - 2 : 1
			for (i = first; i < NR; i++) {
				slot = ((i - 1) % 2) + 1
				target_lines[++target_lines[0]] = previous_lines[slot]
				target_numbers[target_lines[0]] = i
			}
		}
		function reset_latest(    i) {
			for (i in latest_lines) {
				delete latest_lines[i]
			}
			for (i in latest_numbers) {
				delete latest_numbers[i]
			}
			copy_previous(latest_lines, latest_numbers)
		}
		function add_selected(number, line) {
			if (!(number in selected)) {
				selected[number] = line
				numbers[++selected_count] = number
			}
		}
		{
			normalized = $0
			gsub(sprintf("%c", 27) "\\[[0-9;?]*[ -/]*[@-~]", "", normalized)
			lower = tolower(normalized)
			marker = lower ~ /(^|[^[:alpha:]])(fail|failed|failure|error|typeerror|assertionerror|expected|actual|received|not ok)([^[:alpha:]]|$)/
			if (marker && !first_marker_found) {
				first_marker_found = 1
				copy_previous(first_lines, first_numbers)
				first_lines[++first_lines[0]] = $0
				first_numbers[first_lines[0]] = NR
				first_remaining = 7
			}
			else if (first_remaining > 0) {
				first_lines[++first_lines[0]] = $0
				first_numbers[first_lines[0]] = NR
				first_remaining--
			}
			if (marker) {
				reset_latest()
				latest_lines[++latest_lines[0]] = $0
				latest_numbers[latest_lines[0]] = NR
				latest_remaining = 7
			}
			else if (latest_remaining > 0) {
				latest_lines[++latest_lines[0]] = $0
				latest_numbers[latest_lines[0]] = NR
				latest_remaining--
			}
			previous_slot = ((NR - 1) % 2) + 1
			previous_lines[previous_slot] = $0
			tail_slot = ((NR - 1) % 30) + 1
			tail_lines[tail_slot] = $0
			tail_numbers[tail_slot] = NR
		}
		END {
			for (i = 1; i <= first_lines[0]; i++) {
				add_selected(first_numbers[i], first_lines[i])
			}
			for (i = 1; i <= latest_lines[0]; i++) {
				add_selected(latest_numbers[i], latest_lines[i])
			}
			first_tail = NR > 29 ? NR - 29 : 1
			for (i = first_tail; i <= NR; i++) {
				tail_slot = ((i - 1) % 30) + 1
				add_selected(tail_numbers[tail_slot], tail_lines[tail_slot])
			}
			for (i = 2; i <= selected_count; i++) {
				number = numbers[i]
				j = i - 1
				while (j >= 1 && numbers[j] > number) {
					numbers[j + 1] = numbers[j]
					j--
				}
				numbers[j + 1] = number
			}
			previous = 0
			for (i = 1; i <= selected_count; i++) {
				number = numbers[i]
				if (previous > 0 && number > previous + 1) {
					print "[... diagnostics omitted ...]"
				}
				print selected[number]
				previous = number
			}
		}
	' "$1"
}

print_bounded_context() {
	local excerpt excerpt_bytes half_bytes
	excerpt="$(extract_failure_context "$1")"
	excerpt_bytes="$(printf '%s' "$excerpt" | wc -c | tr -d ' ')"
	if ((excerpt_bytes <= FAILURE_EXCERPT_BYTES)); then
		printf '%s\n' "$excerpt"
		return
	fi
	half_bytes="$((FAILURE_EXCERPT_BYTES / 2 - 32))"
	printf '%s' "$excerpt" | head -c "$half_bytes"
	printf '\n[... diagnostics omitted by byte limit ...]\n'
	printf '%s' "$excerpt" | tail -c "$half_bytes"
	printf '\n'
}

mode="passthrough"
if (($# == 2)) && [[ "$1" == "run" ]]; then
	case "$2" in
		verify|test:unit)
			mode="compact"
			;;
	esac
fi

if [[ "$mode" == "passthrough" ]]; then
	exec npm "$@"
fi

log_dir="$PWD/.agent-logs/npm"
original_umask="$(umask)"
umask 077
mkdir -p "$log_dir" || fail "could not create npm log directory: $log_dir"
if ! log_file="$(mktemp "$log_dir/npm-lite.XXXXXX")"; then
	umask "$original_umask"
	rmdir "$log_dir" 2>/dev/null || true
	rmdir "$PWD/.agent-logs" 2>/dev/null || true
	fail "could not create npm log in: $log_dir"
fi
if ! visible_file="$(mktemp "$log_dir/npm-lite-visible.XXXXXX")"; then
	rm -f -- "$log_file" || warn "could not remove incomplete npm log: $log_file"
	umask "$original_umask"
	rmdir "$log_dir" 2>/dev/null || true
	rmdir "$PWD/.agent-logs" 2>/dev/null || true
	fail "could not create npm summary file in: $log_dir"
fi
umask "$original_umask"
trap 'forward_signal INT 130' INT
trap 'forward_signal TERM 143' TERM
npm "$@" > "$log_file" 2>&1 &
child_pid=$!
wait "$child_pid"
status=$?
child_pid=""
trap - INT TERM
duration="$(($(date +%s) - started_at))"
prune_old_logs

if ((status == 0)); then
	test_count="$(extract_test_count "$log_file")"
	if [[ -n "$test_count" ]]; then
		printf 'PASS · %s tests · %s s\n' "$test_count" "$duration" > "$visible_file"
	else
		printf 'PASS · %s s\n' "$duration" > "$visible_file"
	fi
else
	printf 'FAIL · exit %d · %s s\n\n' "$status" "$duration" > "$visible_file"
	log_lines="$(awk 'END { print NR }' "$log_file")"
	log_bytes="$(wc -c < "$log_file" | tr -d ' ')"
	if ((log_lines <= 80 && log_bytes <= FAILURE_EXCERPT_BYTES)); then
		command cat "$log_file" >> "$visible_file"
	else
		printf '[failure diagnostics selected from error context and the final summary; limited to 80 lines and %d bytes]\n' "$FAILURE_EXCERPT_BYTES" >> "$visible_file"
		print_bounded_context "$log_file" >> "$visible_file"
	fi
	printf '\nLog: %s\n' "$log_file" >> "$visible_file"
fi

command cat "$visible_file"
rm -f -- "$visible_file" || warn "could not remove npm summary file: $visible_file"
if ((status == 0)); then
	if rm -f -- "$log_file"; then
		rmdir "$log_dir" 2>/dev/null || true
		rmdir "$PWD/.agent-logs" 2>/dev/null || true
	else
		warn "could not remove successful npm log: $log_file"
	fi
fi
exit "$status"
