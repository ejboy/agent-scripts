#!/usr/bin/env bash

set -uo pipefail

printf '%s\0' "$#" "$@" >> "${FAKE_NPM_CALLS:?}"

case "${FAKE_NPM_MODE:-success}" in
	success)
		printf 'setup output\n'
		printf '267 passing (4s)\n'
		;;
	failure)
		printf 'setup output\n'
		printf 'AssertionError: expected true but got false\n' >&2
		exit 7
		;;
	long-failure)
		printf 'FAIL npm-lite induced failure\n'
		printf 'Actual: actual\n'
		printf 'Expected: expected\n'
		for line in {1..116}; do
			printf 'diagnostic line %d\n' "$line"
		done
		printf 'diagnostic line 120 '
		printf '%*s' 20000 '' | tr ' ' x
		printf '\n'
		printf 'failing: 1\n'
		exit 8
		;;
	streaming-failure)
		printf 'FAIL streaming failure\n'
		printf 'Actual: actual\n'
		printf 'Expected: expected\n'
		for line in {1..250000}; do
			printf 'streaming diagnostic line %d\n' "$line"
		done
		printf 'failing: 1\n'
		exit 10
		;;
	unterminated-failure)
		for line in {1..80}; do
			printf 'diagnostic line %d\n' "$line"
		done
		printf 'FAIL unterminated line 81'
		exit 11
		;;
	signal-wait)
		trap 'exit 130' INT
		trap 'exit 143' TERM
		sleep 30 &
		child_pid=$!
		printf '%s\n' "$$" >"${FAKE_NPM_PID_FILE:?}"
		printf '%s\n' "$child_pid" >"${FAKE_NPM_CHILD_PID_FILE:?}"
		wait "$child_pid"
		;;
	no-count)
		printf 'completed without a recognized test count\n'
		;;
	ansi-tap)
		printf '\033[32mpassing:\033[39m   \033[32m1108\033[39m\n'
		;;
	*)
		printf 'unknown fake mode\n' >&2
		exit 9
		;;
esac
