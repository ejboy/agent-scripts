#!/usr/bin/env bash
set -uo pipefail

printf '%s\n' "$@" >"$FAKE_ARGS_FILE"
printf '%s\n' "${FAKE_NAME:-mvn}" >"$FAKE_INVOKED_FILE"

case "${FAKE_MODE:-success}" in
	success)
		printf '%s\n' '[INFO] BUILD SUCCESS'
		printf '%s\n' '[INFO] Total time: 1.234 s'
		exit 0
		;;
	compiler)
		printf '%s\n' "[ERROR] $FAKE_PROJECT_DIR/src/main/java/App.java:[4,9] cannot find symbol"
		printf '%s\n' '[ERROR]   symbol:   variable missing'
		printf '%s\n' '[ERROR] Failed to execute goal org.apache.maven.plugins:maven-compiler-plugin:compile on project app'
		exit 17
		;;
	surefire-failure)
		printf '%s\n' '[ERROR] Tests run: 1, Failures: 1, Errors: 0, Skipped: 0, Time elapsed: 0.01 s <<< FAILURE! -- in com.example.AppTest'
		printf '%s\n' '[ERROR] com.example.AppTest.shouldRejectInvalidInput -- Time elapsed: 0.01 s <<< FAILURE!'
		printf '%s\n' '[ERROR] java.lang.AssertionError: expected 400'
		exit 1
		;;
	failsafe-failure)
		printf '%s\n' '[ERROR] shouldStartService(com.example.AppIT)  Time elapsed: 0.04 s  <<< ERROR!'
		printf '%s\n' '[ERROR] java.lang.IllegalStateException: service unavailable'
		exit 1
		;;
	dependency-resolution)
		printf '%s\n' '[ERROR] Failed to execute goal on project app: Could not resolve dependencies for project com.example:app:jar:1.0'
		printf '%s\n' '[ERROR] dependency: com.example:missing-lib:jar:2.0'
		printf '%s\n' '[ERROR] Could not find artifact com.example:missing-lib:jar:2.0 in central'
		exit 1
		;;
	goal)
		printf '%s\n' '[ERROR] Failed to execute goal org.apache.maven.plugins:maven-enforcer-plugin:enforce on project app'
		exit 9
		;;
	goal-cause)
		printf '%s\n' '[ERROR] Failed to execute goal org.apache.maven.plugins:maven-surefire-plugin:3.2.5:test (default-test) on project app: Execution default-test failed: Unable to create temporary directory -> [Help 1]'
		printf '%s\n' '[ERROR] Failed to execute goal org.apache.maven.plugins:maven-surefire-plugin:3.2.5:test (secondary-test) on project app: Execution secondary-test failed: Unable to create temporary directory -> [Help 1]'
		exit 11
		;;
	goal-mojo-cause)
		printf '%s\n' '[ERROR] Failed to execute goal org.example:example-plugin:1.0:run (default) on project app: org.apache.maven.plugin.MojoExecutionException: Generated output directory is not writable -> [Help 1]'
		exit 12
		;;
	goal-raw-cause)
		printf '%s\n' '[ERROR] Failed to execute goal org.example:example-plugin:1.0:run (default) on project app: Generated output directory is not writable -> [Help 1]'
		exit 13
		;;
	maven-command-error)
		printf '%s\n' '[ERROR] Unknown lifecycle phase "teest". You must specify a valid lifecycle phase or a goal in the format <plugin-prefix>:<goal>. Available lifecycle phases are: pre-clean, clean, post-clean, validate, compile, test, package, verify, install, deploy. -> [Help 1]'
		exit 2
		;;
	maven-no-plugin)
		printf '%s\n' "[ERROR] No plugin found for prefix 'missing' in the current project and in the plugin groups [org.apache.maven.plugins, org.codehaus.mojo] available from the repositories [local (/tmp/repository), central (https://repo.maven.apache.org/maven2)] -> [Help 1]"
		exit 2
		;;
	maven-parent-pom)
		printf '%s\n' "[ERROR] Non-resolvable parent POM for com.example:app:1.0: The following artifacts could not be resolved: com.example:parent:pom:1.0 (absent): Could not find artifact com.example:parent:pom:1.0 in central and 'parent.relativePath' points at wrong local POM @ /workspace/pom.xml, line 5, column 11 -> [Help 2]"
		exit 2
		;;
	maven-requires-project)
		printf '%s\n' '[ERROR] The goal you specified requires a project to execute but there is no POM in this directory (/workspace). Please verify you invoked Maven from the correct directory. -> [Help 1]'
		exit 2
		;;
	maven-pom-problems)
		printf '%s\n' '[ERROR] Some problems were encountered while processing the POMs: -> [Help 1]'
		printf '%s\n' '[ERROR]'
		printf '%s\n' "[ERROR] 'dependencies.dependency.version' for com.example:library:jar is missing. @ /workspace/pom.xml, line 24, column 15 -> [Help 2]"
		printf '%s\n' "[ERROR] 'build.plugins.plugin.version' for org.example:plugin is missing. @ /workspace/pom.xml, line 30, column 17"
		exit 2
		;;
	unknown)
		for line_number in {1..100}; do
			printf 'unrecognized failure line %s\n' "$line_number"
		done
		exit 7
		;;
	read-stdin)
		if [[ -n "${FAKE_STDIN_PID_FILE:-}" ]]; then
			printf '%s\n' "$$" >"$FAKE_STDIN_PID_FILE"
		fi
		if IFS= read -r input; then
			printf 'unexpected stdin: %s\n' "$input" >&2
			exit 19
		fi
		printf '%s\n' '[INFO] BUILD SUCCESS'
		printf '%s\n' '[INFO] Total time: 1.234 s'
		exit 0
		;;
	read-tty)
		if [[ -n "${FAKE_STDIN_PID_FILE:-}" ]]; then
			printf '%s\n' "$$" >"$FAKE_STDIN_PID_FILE"
		fi
		IFS= read -r input </dev/tty || true
		printf '%s\n' '[INFO] BUILD SUCCESS'
		printf '%s\n' '[INFO] Total time: 1.234 s'
		exit 0
		;;
	version)
		printf '%s\n' 'Apache Maven 3.9.9'
		printf '%s\n' 'Maven home: /opt/maven'
		printf '%s\n' 'Java version: 17'
		exit 0
		;;
	help)
		printf '%s\n' 'usage: mvn [options] [<goal(s)>] [<phase(s)>]'
		exit 0
		;;
	wait-for-signal)
		sleep 30 &
		wait_pid=$!
		printf '%s\n' "$$" >"$FAKE_SIGNAL_PID_FILE"
		terminate_for_test() {
			local status="$1"
			kill -TERM "$wait_pid" 2>/dev/null || true
			wait "$wait_pid" 2>/dev/null || true
			printf '%s\n' terminated >"$FAKE_SIGNAL_EXIT_FILE"
			exit "$status"
		}
		trap 'terminate_for_test 130' INT
		trap 'terminate_for_test 143' TERM
		wait "$wait_pid"
		;;
esac
